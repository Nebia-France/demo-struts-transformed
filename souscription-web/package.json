{
  "name": "souscription-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "prebuild": "node scripts/write-version.mjs",
    "build": "ng build --configuration production && node scripts/precompress.mjs && node scripts/check-initial-budget.mjs",
    "build:dev": "ng build --configuration development",
    "check:no-dom-escape": "node scripts/check-no-dom-escape.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "contract:consumer": "playwright test e2e/contract",
    "check:di": "node scripts/check-no-string-di.mjs",
    "check:functional": "node scripts/check-functional-only.mjs",
    "check:no-localstorage": "node scripts/check-no-local-journey.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:csrf": "node scripts/check-csrf-names.mjs",
    "check:no-sw": "node scripts/check-no-sw.mjs",
    "check:methods": "node scripts/check-http-methods.mjs",
    "check:no-cors": "node scripts/check-no-cors.mjs",
    "check:track": "node scripts/check-track.mjs",
    "check:allocation": "node scripts/check-allocation.mjs",
    "check:no-pending": "node scripts/check-no-pending.mjs",
    "check:rate": "node scripts/check-scenario-rate.mjs",
    "check:audit": "node scripts/check-audit-record.mjs",
    "check:no-struts": "node scripts/check-no-struts-ref.mjs",
    "check:labels:inventory": "node scripts/label-inventory.mjs",
    "check:contract": "node scripts/check-contract-validation.mjs",
    "lint": "npm run contract:check && npm run check:money && npm run check:no-retry && npm run check:no-dom-escape && npm run check:di && npm run check:functional && npm run check:no-localstorage && npm run check:labels && npm run check:csp && npm run check:csrf && npm run check:no-sw && npm run check:methods && npm run check:no-cors && npm run check:track && npm run check:privacy && npm run check:allocation && npm run check:no-pending && npm run check:rate && npm run check:audit && npm run check:no-struts && npm run check:labels:inventory && npm run check:contract && ng lint",
    "test": "ng test --watch=false",
    "e2e": "cucumber-js --config e2e/cucumber.cjs; status=$?; node scripts/scenario-rate.mjs; exit $status",
    "scenario:rate": "node scripts/scenario-rate.mjs",
    "e2e:dry": "cucumber-js --config e2e/cucumber.cjs --dry-run",
    "e2e:operational": "cucumber-js --config e2e/cucumber.cjs --profile operational",
    "api:generate": "openapi-typescript contracts/openapi.yaml -o src/app/api/models/schema.ts",
    "api:verify": "npm run api:generate && git diff --exit-code src/app/api/models/schema.ts",
    "check:money": "node scripts/check-money-types.mjs",
    "check:no-retry": "node scripts/check-no-retry.mjs",
    "perf:lh": "lhci autorun --config=lighthouserc.json",
    "perf:steps": "playwright test --project perf",
    "dast": "playwright test --project dast",
    "perf:load": "node scripts/load-test.mjs",
    "visual": "playwright test e2e/visual --update-snapshots=missing",
    "check:labels": "node scripts/check-labels.mjs",
    "a11y": "playwright test e2e/a11y",
    "api:negative": "playwright test e2e/api",
    "check:privacy": "node scripts/check-telemetry-privacy.mjs",
    "e2e:journeys": "playwright test e2e/journeys"
  },
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "rxjs": "7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@axe-core/playwright": "^4.10.0",
    "@cucumber/cucumber": "^11.0.1",
    "@eslint/js": "^9.13.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.48.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "angular-eslint": "^21.0.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.13.0",
    "jsdom": "^31.0.0",
    "msw": "^2.6.0",
    "openapi-typescript": "^7.4.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.12.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "basic-ftp": "^6.2.6"
  }
}
